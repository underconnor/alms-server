# Build the controlled-playback QA fixture image first. No production secrets enter this image.
ARG CONTROLLED_QA_IMAGE=alms-controlled-playback-qa:local
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY vendor ./vendor
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev
FROM ${CONTROLLED_QA_IMAGE}
WORKDIR /app
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node scripts/playback-runtime-probe-qa.mjs scripts/controlled-playback-runtime-qa.mjs ./scripts/
USER node
CMD ["node", "scripts/playback-runtime-probe-qa.mjs"]
