{
  "name": "alms-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker-main.js",
    "migrate": "tsx src/migrate.ts",
    "analytics:summary": "tsx src/analytics-summary.ts",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "check": "npm run build && npm test",
    "contract:generate": "tsx scripts/generate-http-contract.ts"
  },
  "dependencies": {
    "@alms/ssu-api": "file:vendor/alms-ssu-api-0.3.39.tgz",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/formbody": "9.0.1",
    "@fastify/rate-limit": "11.2.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cheerio": "1.2.0",
    "fastify": "5.12.7",
    "oidc-provider": "9.12.2",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "playwright": "1.63.0",
    "tldts": "7.4.18",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
