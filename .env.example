# Local Node development only. The application does not load this file automatically.
# Copy to .env, set DATABASE_URL, and use node --env-file=.env dist/server.js.
# Compose fixes production mode and requires HTTPS origins; see README.md.
DATABASE_URL=postgres://alms:replace-this@localhost:5432/alms
NODE_ENV=development
HOST=127.0.0.1
PORT=4300
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173
SESSION_TTL_SECONDS=86400
APP_VERSION=0.1.0
GIT_COMMIT=unknown
API_PUBLIC_ORIGIN=http://localhost:4300
FRONTEND_ORIGIN=http://localhost:5173

# Additional exact-origin web clients. The built-in client ID is alms-web.
# Cross-site clients require bearer mode and S256 PKCE. See docs/http-contract.md.
FRONTEND_CLIENTS_JSON=

# Base64 of 32 random bytes, injected from a private secret store.
# Keep this key stable while existing encrypted records are in use.
SESSION_ENCRYPTION_KEY=
SSU_AUTH_ENABLED=false
SSU_READ_ENABLED=false
SSU_SAINT_READ_ENABLED=false
SSU_PLAYBACK_ENABLED=false

# Optional read-only MCP, enabled only in the API role.
# Requires migration 015, SESSION_ENCRYPTION_KEY and persistent private key material.
MCP_ENABLED=false
MCP_SIGNING_JWKS_JSON=
MCP_COOKIE_KEYS_JSON=

# Optional PostHog EU project key. Empty disables external event delivery.
POSTHOG_PROJECT_KEY=

# Required by Compose; local Node commands use DATABASE_URL directly.
# Use a URL-safe random password and a separate .env.compose with HTTPS origins.
POSTGRES_PASSWORD=

# Integration tests require a separate database named alms_test or alms_qa.
# TEST_DATABASE_URL=postgres://alms:replace-this@localhost:5432/alms_test
