{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"], "strict": true, "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true, "esModuleInterop": true, "skipLibCheck": true,
    "outDir": "dist", "rootDir": "src", "resolveJsonModule": true,
    "sourceMap": true, "declaration": true
  },
  "include": ["src/**/*.ts"]
}
